<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background">

    <!-- Lingkaran dekoratif atas kanan -->
    <View
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:background="@drawable/splash_circle"
        android:alpha="0.08"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="-80dp"
        android:layout_marginEnd="-80dp"/>

    <!-- Lingkaran dekoratif bawah kiri -->
    <View
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/splash_circle"
        android:alpha="0.06"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="-60dp"
        android:layout_marginStart="-60dp"/>

    <!-- Konten tengah -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Logo container -->
        <FrameLayout
            android:id="@+id/splashLogo"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginBottom="28dp">

            <!-- Background lingkaran putih semi-transparan -->
            <View
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:background="@drawable/splash_logo_bg"/>

            <!-- Logo sekolah -->
            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:src="@mipmap/ic_launcher_round"
                android:scaleType="centerCrop"
                android:contentDescription="Logo Sekolah"/>
        </FrameLayout>

        <!-- Nama aplikasi -->
        <TextView
            android:id="@+id/splashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EduWeb"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="4dp"/>

        <!-- Nama sekolah -->
        <TextView
            android:id="@+id/splashSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SMK Alhikmah Tanon"
            android:textColor="#C2CEFE"
            android:textSize="15sp"
            android:textStyle="normal"
            android:letterSpacing="0.02"
            android:layout_marginBottom="8dp"/>

    </LinearLayout>

    <!-- Tagline di bawah -->
    <TextView
        android:id="@+id/splashTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sistem Informasi Manajemen Sekolah"
        android:textColor="#ffffff"
        android:textSize="11sp"
        android:alpha="0.5"
        android:letterSpacing="0.08"
        android:textAllCaps="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="48dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
