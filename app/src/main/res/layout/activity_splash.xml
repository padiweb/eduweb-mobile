<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background">

    <!-- Lingkaran dekoratif atas kanan -->
    <View
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:background="@drawable/splash_circle"
        android:alpha="0.06"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="-100dp"
        android:layout_marginEnd="-100dp"/>

    <!-- Lingkaran dekoratif bawah kiri -->
    <View
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/splash_circle"
        android:alpha="0.05"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="-70dp"
        android:layout_marginStart="-70dp"/>

    <!-- Konten utama tengah -->
    <LinearLayout
        android:id="@+id/splashContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Logo tanpa lingkaran -->
        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@mipmap/ic_launcher"
            android:scaleType="fitCenter"
            android:layout_marginBottom="32dp"
            android:contentDescription="Logo"/>

        <!-- Nama aplikasi besar -->
        <TextView
            android:id="@+id/splashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Altan Mobile"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:layout_marginBottom="6dp"/>

        <!-- Garis pemisah tipis -->
        <View
            android:id="@+id/splashDivider"
            android:layout_width="40dp"
            android:layout_height="2dp"
            android:background="#60FFFFFF"
            android:layout_marginBottom="12dp"/>

        <!-- Sub judul -->
        <TextView
            android:id="@+id/splashSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EduWeb SMK Alhikmah Tanon"
            android:textColor="#C2CEFE"
            android:textSize="13sp"
            android:letterSpacing="0.01"
            android:gravity="center"/>

    </LinearLayout>

    <!-- Loading dots di bawah -->
    <LinearLayout
        android:id="@+id/splashTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/splash_circle"
            android:alpha="0.8"
            android:layout_marginEnd="6dp"/>
        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/splash_circle"
            android:alpha="0.4"
            android:layout_marginEnd="6dp"/>
        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/splash_circle"
            android:alpha="0.4"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
