<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EduWeb" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#2563eb</item>
        <item name="colorPrimaryDark">#1e40af</item>
        <item name="android:statusBarColor">#1e40af</item>
        <item name="android:navigationBarColor">#ffffff</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.EduWeb.Splash" parent="Theme.EduWeb">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">#3960FB</item>
        <item name="android:navigationBarColor">#142258</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
